# Copy to .env. Production values live in /opt/disgrowth/store/.env and are never committed.
# Empty values and placeholders such as "-" or "blank" are treated as unset.
# For local development, set STORE_ORIGIN=http://localhost:3000.

# Required to boot
# 32+ random characters.
SESSION_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The Postgres database the Discord bot uses, e.g.
# postgres://market_game:PASSWORD@127.0.0.1:5432/market_game
DATABASE_URL=

# Required to sell
STORE_ORIGIN=https://disgrowth.net
# sandbox or production
PADDLE_ENV=production
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Client-side token (live_… or test_…) from Paddle > Developer tools > Authentication.
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_GOLD_10=pri_01m1vqmtydg3hrzxhsecae8d9v
PADDLE_PRICE_GOLD_25=pri_01m1vqmv2z51ehpf7f1bcd01jf
PADDLE_PRICE_GOLD_50=pri_01m1vqmv7e7v51nja2mdcr7bgt
PADDLE_PRICE_GOLD_100=pri_01m1vqmvby50aw445v47wn7k16

# Legal (the footer shows a preview notice until OPERATOR_LEGAL_NAME is set)
OPERATOR_LEGAL_NAME=Kaelis Quinn
OPERATOR_CONTACT_EMAIL=kaelisquinn@gmail.com
SUPPORT_EMAIL=kaelisquinn@gmail.com
PRIVACY_EMAIL=kaelisquinn@gmail.com

# Optional
# DATABASE_SSL=1
# DISCORD_REDIRECT_URI defaults to STORE_ORIGIN + /api/auth/discord/callback.
