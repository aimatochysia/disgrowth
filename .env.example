# Production on the VPS: fill this file as /opt/disgrowth/.env (never commit it).
# Vercel cannot use 127.0.0.1 — run the store on the same machine as Postgres.
# Never use "-" or "blank". Do not set NODE_ENV or PORT on Vercel.

# --- Docker Postgres on the VPS (docker compose reads this) ---
POSTGRES_PASSWORD=

# --- required to boot ---
# SESSION_SECRET must be 32+ random characters, not the word SESSION_SECRET.
SESSION_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Same Postgres the Discord bot uses. On the VPS that is localhost:
#   postgres://market_game:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/market_game
# Do not put this URL on Vercel. Do not expose 5432 on the public NIC.
DATABASE_URL=

# --- required to sell ---
# Public HTTPS origin of the store (TierHive HAProxy hostname or your domain).
# Not the VPS hostname field. Example later: https://disgrowth.example.com
STORE_ORIGIN=https://YOUR-PROJECT.vercel.app
# Must be sandbox or production. Never omit this — the app will not guess.
PADDLE_ENV=production
# Live Paddle Billing keys — not the word "blank".
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Client-side token (live_… or test_…). Create under Developer tools > Authentication.
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_GOLD_10=pri_01m1vqmtydg3hrzxhsecae8d9v
PADDLE_PRICE_GOLD_25=pri_01m1vqmv2z51ehpf7f1bcd01jf
PADDLE_PRICE_GOLD_50=pri_01m1vqmv7e7v51nja2mdcr7bgt
PADDLE_PRICE_GOLD_100=pri_01m1vqmvby50aw445v47wn7k16

# --- legal (preview banner stays until OPERATOR_LEGAL_NAME is set) ---
OPERATOR_LEGAL_NAME=Kaelis Quinn
OPERATOR_CONTACT_EMAIL=kaelisquinn@gmail.com
SUPPORT_EMAIL=kaelisquinn@gmail.com
PRIVACY_EMAIL=kaelisquinn@gmail.com

# --- only if needed ---
# DATABASE_SSL=1
# DISCORD_REDIRECT_URI is STORE_ORIGIN + /api/auth/discord/callback unless you set it
# Local: STORE_ORIGIN=http://localhost:3000
